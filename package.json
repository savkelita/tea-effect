{
  "name": "tea-effect",
  "version": "0.8.3",
  "description": "The Elm Architecture for TypeScript with Effect",
  "keywords": [
    "elm",
    "tea",
    "the-elm-architecture",
    "effect",
    "effect-ts",
    "functional-programming",
    "react",
    "typescript"
  ],
  "author": "Marko Savic",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/savkelita/tea-effect"
  },
  "homepage": "https://savkelita.github.io/tea-effect/",
  "bugs": {
    "url": "https://github.com/savkelita/tea-effect/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Cmd": {
      "types": "./dist/Cmd.d.ts",
      "default": "./dist/Cmd.js"
    },
    "./Sub": {
      "types": "./dist/Sub.d.ts",
      "default": "./dist/Sub.js"
    },
    "./Task": {
      "types": "./dist/Task.d.ts",
      "default": "./dist/Task.js"
    },
    "./Platform": {
      "types": "./dist/Platform.d.ts",
      "default": "./dist/Platform.js"
    },
    "./Html": {
      "types": "./dist/Html.d.ts",
      "default": "./dist/Html.js"
    },
    "./React": {
      "types": "./dist/React.d.ts",
      "default": "./dist/React.js"
    },
    "./Navigation": {
      "types": "./dist/Navigation.d.ts",
      "default": "./dist/Navigation.js"
    },
    "./Http": {
      "types": "./dist/Http.d.ts",
      "default": "./dist/Http.js"
    },
    "./LocalStorage": {
      "types": "./dist/LocalStorage.d.ts",
      "default": "./dist/LocalStorage.js"
    },
    "./Router": {
      "types": "./dist/Router.d.ts",
      "default": "./dist/Router.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "example:counter": "npx tsx examples/test-counter.ts",
    "example:userlist": "npx tsx examples/test-runtime.ts",
    "example:http": "npx tsx examples/test-http.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:typecheck": "tsc -p docs/examples/tsconfig.json",
    "docs:api": "npm run build && docgen",
    "prepublishOnly": "npm run build && npm run smoke:dist",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.117",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/docgen": "^0.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "effect": "4.0.0-rc.117",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.0.0"
  }
}
